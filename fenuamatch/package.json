{
  "name": "fenuamatch",
  "version": "1.0.0",
  "description": "FenuaMatch — mise en relation clients / prestataires à Tahiti",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/with-local-supabase.mjs vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:db": "node scripts/with-local-supabase.mjs vitest run -c vitest.integration.config.ts",
    "test:e2e": "node scripts/with-local-supabase.mjs playwright test --trace off",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "icons": "node scripts/generate-icons.mjs",
    "seed:demo": "node scripts/with-local-supabase.mjs node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
