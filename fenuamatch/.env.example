# Copiez ce fichier en ".env.local" puis remplissez les valeurs de VOTRE projet Supabase.
# Supabase > Project Settings > API (ou "Connect").

# URL du projet, ex. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Clé PUBLIQUE uniquement : "publishable key" (sb_publishable_...) ou ancienne "anon key".
# Ne mettez JAMAIS ici la "secret key" / "service_role key".
VITE_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique du site (sert aux liens des e-mails). Ex. https://fenuamatch.pages.dev
VITE_SITE_URL=http://localhost:5173
